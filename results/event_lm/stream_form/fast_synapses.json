{
 "note": "Fast output synapses that every arriving byte teaches, measured during training on weights saved then. All rows score the first bytes of the enwik8 validation split as unbroken streams with a lead of 8,192 bytes. The synapses start at zero in every stream and learn from the unscored lead too. 'over_plain' is the difference to the same streams without fast synapses. The levels and the threshold of the final scorings were chosen from these rows.",
 "float_probes": {
  "note": "The rule in floats beside a frozen stack (not the model's whole-number mechanism): the change of a synapse is the rate times the share of the readout that its output neuron missed times the activity of the fibre. 'keep' below 1 lets the synapses leak towards zero at every byte. First 300,000 validation bytes, 16 streams, the window-trained stack.",
  "populations": {
   "stream": "the stream into the output neurons, scaled to unit length",
   "cells": "the cells after the last level, less each cell's running mean, scaled to unit length",
   "both": "the stream and the last level's cells together",
   "raw": "the last level's cells without centring",
   "pool": "the last level's cells less the mean of the population at that byte",
   "l1": "the last level's cells less each cell's running mean, scaled by the summed sizes",
   "cells3": "the cells after the last three levels, less each cell's running mean",
   "c3": "the cells after the last three levels, one rate",
   "c3f": "the cells after the last three levels, a rate per fibre that falls with the root of the fibre's summed squared activity",
   "c3s": "the cells after the last three levels, a rate per synapse that falls with the root of its summed squared changes",
   "c11": "the cells after all eleven levels, one rate"
  },
